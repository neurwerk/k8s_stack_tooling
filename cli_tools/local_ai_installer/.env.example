# Explicit target; the installer never falls back to the current Docker context.
LOCAL_AI_INSTALLER_DOCKER_CONTEXT=ai-server
# Choose the target host's private interface for LAN clients.
LOCALAI_BIND_ADDRESS=127.0.0.1
LOCALAI_PORT=8080
LOCALAI_API_KEY=

# External storage for models AND the offline Docker/backend bundle.
# Run `local-ai-installer images` with workstation internet before `install`.
LOCAL_AI_INSTALLER_STORAGE_ROOT=/Volumes/ModelStorage
HF_HOME=/Volumes/ModelStorage/huggingface

# Native LocalAI resource controls, not hard per-process VRAM reservations.
LOCALAI_MAX_ACTIVE_BACKENDS=3
LOCALAI_VRAM_BUDGET=14GiB
LOCALAI_THREADS=4
