# Required: an existing external-volume mount, not a directory on the workstation root disk.
MEDIA_DOWNLOADER_UPLOADER_STORAGE_ROOT=/path/to/external-media

# Keeps Hugging Face authentication and download cache on the external volume.
HF_HOME=/path/to/external-media/huggingface

# Required for upload behavior. Every kubectl command receives this value via --context.
# The generic KUBE_CONTEXT variable is accepted too.
MEDIA_DOWNLOADER_UPLOADER_KUBE_CONTEXT=example-cluster

# Rook Ceph RGW upload defaults. The tool retrieves the publisher Secret with
# kubectl and creates a temporary localhost port-forward; credentials are not
# stored in this file.
MEDIA_DOWNLOADER_UPLOADER_RGW_NAMESPACE=infra-rook-ceph
MEDIA_DOWNLOADER_UPLOADER_RGW_SERVICE=infra-rook-ceph-rgw-infra-rook-ceph-object-store
MEDIA_DOWNLOADER_UPLOADER_RGW_BUCKET=pii-models
MEDIA_DOWNLOADER_UPLOADER_RGW_CREDENTIAL_SECRET=rook-ceph-object-user-infra-rook-ceph-object-store-pii-publisher
# A live publisher refreshes this lock between uploads. Recovery requires the lock to be older.
MEDIA_DOWNLOADER_UPLOADER_RGW_PUBLICATION_LOCK_STALE_SECONDS=86400
