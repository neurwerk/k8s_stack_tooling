# Explicit target; the manager never falls back to the current Docker context.
INFERENCE_RUNTIME_MANAGER_DOCKER_CONTEXT=ai-server
# Local Docker Desktop context used only for Linux/AMD64 runtime image builds.
INFERENCE_RUNTIME_MANAGER_BUILD_DOCKER_CONTEXT=desktop-linux
INFERENCE_RUNTIME_MANAGER_API_KEY=
# Use a private target interface when clients need direct access.
INFERENCE_RUNTIME_MANAGER_BIND_ADDRESS=127.0.0.1

# External storage for models and verified offline image archives.
INFERENCE_RUNTIME_MANAGER_STORAGE_ROOT=/Volumes/ModelStorage
HF_HOME=/Volumes/ModelStorage/huggingface

VLM_DOCUMENTS_PORT=8000
LLM_GENERAL_PORT=8001
VLM_GENERAL_PORT=8002
STT_GENERAL_PORT=8003
TTS_GERMAN_PORT=8004
VAD_GENERAL_PORT=8005
NER_GERMAN_PORT=8006

# Runtime computation setting; downloaded Granite weights remain BF16.
VLLM_GRANITE_DTYPE=float32
VLLM_GRANITE_GPU_MEMORY_UTILIZATION=0.25
